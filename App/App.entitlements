<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately NOT sandboxed. The collector reads the login Keychain,
	     arbitrary paths under ~/.config, ~/.claude* and ~/.codex, and spawns
	     the codex binary. None of that survives the sandbox. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>VG87LBRMTR.group.com.erickmenezes.AIUsage</string>
	</array>
</dict>
</plist>
