<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately NOT sandboxed: the collector reads the Keychain, arbitrary
	     paths under ~/.config and ~/.claude*, and spawns the codex binary. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.erickmenezes.aiusage</string>
	</array>
</dict>
</plist>
